<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.freelance.fx.controller.StatisticsController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Статистика" styleClass="page-title"/>
    <Label text="По всей базе данных, а не по заказам, выбранным в таблице" styleClass="status-label"/>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">
        <Button fx:id="refreshButton" text="Обновить" onAction="#onRefresh" styleClass="primary-button"/>
        <ProgressIndicator fx:id="progress" prefWidth="20" prefHeight="20" visible="false" managed="false"/>
        <Label fx:id="errorLabel" styleClass="field-error" wrapText="true" visible="false" managed="false"/>
    </HBox>

    <Label fx:id="emptyLabel" text="В базе пока нет пользователей и заказов" styleClass="status-label"
           visible="false" managed="false"/>

    <FlowPane fx:id="cards" hgap="12" vgap="12"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameColumn" text="Показатель" sortable="false"/>
            <TableColumn fx:id="valueColumn" text="Значение" sortable="false" style="-fx-alignment: CENTER-RIGHT;"/>
        </columns>
    </TableView>
</VBox>
