<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<!-- Экран для первого запуска каркаса. После добавления main.fxml запускается главное окно. -->
<TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.mirea.freelance.fx.StartupController">
    <tabs>
        <Tab text="Пользователи">
            <content><fx:include fx:id="usersView" source="users.fxml"/></content>
        </Tab>
        <Tab text="Статистика">
            <content><fx:include fx:id="statisticsView" source="statistics.fxml"/></content>
        </Tab>
    </tabs>
</TabPane>
