<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.freelance.fx.controller.UsersController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Пользователи" styleClass="page-title"/>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">
        <Button fx:id="addButton" text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger-button"/>
        <Button fx:id="refreshButton" text="Обновить" onAction="#onRefresh"/>
        <ProgressIndicator fx:id="progress" prefWidth="20" prefHeight="20" visible="false" managed="false"/>
    </HBox>

    <Label fx:id="errorLabel" styleClass="field-error" wrapText="true" visible="false" managed="false"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="nameColumn" text="Имя" minWidth="120"/>
            <TableColumn fx:id="emailColumn" text="Email" minWidth="160"/>
            <TableColumn fx:id="roleColumn" text="Роль" minWidth="90" maxWidth="140"/>
            <TableColumn fx:id="ratingColumn" text="Рейтинг" minWidth="70" maxWidth="100"
                         style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="registeredColumn" text="Дата регистрации" minWidth="110" maxWidth="160"/>
        </columns>
    </TableView>
</VBox>
