<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.freelance.fx.controller.OrdersController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Заказы" styleClass="page-title"/>

    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar">
        <Button fx:id="refreshButton" text="Обновить" onAction="#onRefresh" styleClass="primary-button"/>
        <ProgressIndicator fx:id="progress" prefWidth="20" prefHeight="20" visible="false" managed="false"/>
        <Label fx:id="errorLabel" styleClass="field-error" wrapText="true" visible="false" managed="false"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Заказов нет" styleClass="status-label"/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="titleColumn" text="Название" prefWidth="240"/>
            <TableColumn fx:id="categoryColumn" text="Категория" prefWidth="120"/>
            <TableColumn fx:id="budgetColumn" text="Бюджет, ₽" prefWidth="110" style="-fx-alignment: CENTER-RIGHT;"/>
            <TableColumn fx:id="deadlineColumn" text="Дедлайн" prefWidth="100"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="110"/>
            <TableColumn fx:id="customerColumn" text="Заказчик" prefWidth="150"/>
            <TableColumn fx:id="freelancerColumn" text="Исполнитель" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
