<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" prefWidth="520" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.freelance.fx.controller.OrderFormController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label fx:id="headerLabel" styleClass="page-title"/>

    <GridPane hgap="12" vgap="10" styleClass="form-field" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Название*" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="titleField" promptText="до 150 символов" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Описание" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
        <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"
                  GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.vgrow="ALWAYS"/>

        <Label text="Категория*" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryBox" maxWidth="Infinity" promptText="Выберите категорию"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Бюджет, ₽*" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="budgetField" promptText="например 15000,50" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Дедлайн*" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="deadlinePicker" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Заказчик*" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="customerBox" maxWidth="Infinity" promptText="Выберите заказчика"
                  GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label fx:id="customerLabel" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="infoLabel" wrapText="true" styleClass="status-label"/>
    <Label fx:id="errorLabel" wrapText="true" styleClass="field-error"/>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="retryUsersButton" text="Обновить пользователей" onAction="#loadUsers"/>
        <Button fx:id="cancelButton" text="Отмена" cancelButton="true" onAction="#onCancel"/>
        <Button fx:id="saveButton" text="Сохранить" defaultButton="true" onAction="#onSave"
                styleClass="primary-button"/>
    </HBox>
</VBox>
