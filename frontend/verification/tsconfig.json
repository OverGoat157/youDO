{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "baseUrl": ".",
    "paths": { "react": ["node_modules/@types/react"], "react/*": ["node_modules/@types/react/*"], "react-dom/*": ["node_modules/@types/react-dom/*"] }
  },
  "include": ["../src/features/auth", "../src/features/users", "./*.tsx", "./setup.ts"]
}
