# Generate a private backend/.env: python3 backend/scripts/setup_env.py
DB_NAME=youdo_backend
DB_USER=youdo_backend
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_PORT=55433
HTTP_PORT=8080
# Base64 of at least 32 random bytes; never reuse a password here.
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_BYTES
BOOTSTRAP_ADMIN_LOGIN=admin@youdo.local
BOOTSTRAP_ADMIN_NAME=Администратор
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_TEMPORARY_PASSWORD
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
PERMANENT_DELETE_ENABLED=false
